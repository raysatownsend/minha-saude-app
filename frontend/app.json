{
  "expo": {
    "name": "Minha Saude",
    "slug": "minha-saude",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#70D0E0"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
        }
      ]
    ]
  }
}
